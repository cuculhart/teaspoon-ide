{
  "name": "teaspoon-ide",
  "productName": "Teaspoon",
  "version": "0.8.0",
  "description": "Teaspoon IDE - Standalone Electron-based AI coding assistant (a teaspoon of tokens)",
  "main": "electron/main.js",
  "config": {},
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron-forge start",
    "build": "npm run build:vite",
    "build:vite": "vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "start": "electron-forge start",
    "package": "npm run build:vite && electron-forge package",
    "make": "npm run build:vite && electron-forge make"
  },
  "keywords": [
    "electron",
    "ai",
    "editor",
    "gemini"
  ],
  "author": "Teaspoon IDE contributors",
  "license": "FSL-1.1-MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^44.4.3",
    "electron-builder": "^24.9.0",
    "monaco-editor": "^0.56.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@monaco-editor/react": "^4.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.15",
    "dotenv": "^18.0.1",
    "electron-store": "^11.0.2",
    "marked": "^18.0.13",
    "node-pty": "^1.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "simple-git": "^3.20.0"
  }
}
