{
  "name": "teaspoon-ide",
  "productName": "Teaspoon",
  "version": "1.5.1",
  "description": "Teaspoon IDE - Standalone Electron-based AI coding assistant (a teaspoon of tokens)",
  "main": "electron/main.js",
  "config": {},
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "electron-forge start",
    "build": "npm run build:vite",
    "build:vite": "vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "start": "electron-forge start",
    "package": "npm run build:vite && electron-forge package",
    "make": "npm run build:vite && electron-forge make",
    "test:e2e": "node e2e/run.mjs",
    "test:parser": "node e2e/parser.test.mjs"
  },
  "keywords": [
    "electron",
    "ai",
    "editor",
    "gemini"
  ],
  "author": "Teaspoon IDE contributors",
  "license": "FSL-1.1-MIT",
  "overrides": {
    "monaco-editor": {
      "dompurify": "^3.4.16"
    }
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "monaco-editor": "^0.57.0",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.6",
    "marked": "^18.1.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simple-git": "^4.0.2"
  }
}
